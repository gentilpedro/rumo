@page "/amigos/{Code}"

@using EnadeAds.Data
@using EnadeAds.Friends
@using Microsoft.AspNetCore.Identity

@inject FriendService Friends
@inject UserManager<ApplicationUser> Users
@inject NavigationManager Navigation

@if (ownerName is not null)
{
    <PageTitle>Convite de @ownerName · Amigos</PageTitle>

    @* Prévia do link no WhatsApp e nas redes: só o nome abreviado de quem mandou. *@
    <HeadContent>
        <meta property="og:title" content="@ownerName te chamou para ser amigo no Rumo" />
        <meta property="og:description" content="Estudem juntos: vejam quem está estudando e desafiem um ao outro." />
        <meta property="og:type" content="website" />
    </HeadContent>

    <nav aria-label="Trilha">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="amigos">Amigos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Convite de @ownerName</li>
        </ol>
    </nav>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    <section class="game-hero" aria-labelledby="invite-title">
        <p class="game-kicker">Amigos no Rumo</p>
        <h1 id="invite-title">@ownerName te chamou para ser amigo</h1>
        <p class="text-body-secondary">
            Ao pedir a amizade, @ownerName vê o seu <strong>primeiro nome com a inicial do sobrenome</strong>, e mais nada da sua conta.
            Vocês só viram amigos se @ownerName aceitar. Não há conversa, e qualquer um dos dois desfaz a amizade quando quiser.
        </p>

        @if (userId is null)
        {
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="@LoginUrl">Entrar para pedir a amizade</a>
                <a class="btn btn-outline-primary" href="Account/Register">Criar conta</a>
            </div>
        }
        else if (isOwnLink)
        {
            <p class="alert alert-secondary mb-0" role="status">Este é o seu link. Mande para quem você quer ter como amigo, ou <a href="amigos">veja os seus amigos</a>.</p>
        }
        else
        {
            <form method="post" action="amigos/@Code" @formname="request-friend" @onsubmit="RequestAsync">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-primary btn-lg">Pedir amizade</button>
            </form>
        }
    </section>
}

@code {
    private string? ownerName;
    private bool isOwnLink;
    private string? userId;
    private string? message;

    [Parameter]
    public string Code { get; set; } = "";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string LoginUrl => $"Account/Login?ReturnUrl={Uri.EscapeDataString($"/amigos/{Code}")}";

    protected override async Task OnInitializedAsync()
    {
        userId = Users.GetUserId(HttpContext.User);
        if (await Friends.OwnerOfAsync(Code) is not { } owner)
        {
            Navigation.NotFound();
            return;
        }

        ownerName = owner.Name;
        isOwnLink = owner.UserId == userId;
    }

    private async Task RequestAsync()
    {
        if (userId is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status401Unauthorized;
            return;
        }

        var outcome = await Friends.RequestByCodeAsync(userId, Code);
        if (FriendMessages.Notice(outcome) is { } notice)
        {
            // GET depois do POST: recarregar a página não envia o pedido de novo.
            Navigation.NavigateTo($"amigos?aviso={notice}");
            return;
        }

        message = FriendMessages.Problem(outcome);
        HttpContext.Response.StatusCode = StatusCodes.Status409Conflict;
    }
}
